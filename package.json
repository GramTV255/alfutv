{
  "name": "alfutvpromax",
  "version": "1.0.0",
  "private": true,
  "description": "TV Streaming system: Node.js + PostgreSQL + ClickPesa",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate": "node -e \"require('dotenv').config();const fs=require('fs');const {pool}=require('./src/config/database');pool.query(fs.readFileSync('database/schema.sql','utf8')).then(()=>{console.log('Schema OK');process.exit(0)}).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  }
}
